<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Работа с файлами"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etFileData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Введите текст для сохранения"
        app:layout_constraintTop_toBottomOf="@id/tvFileTitle" />

    <TextView
        android:id="@+id/tvFileContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="#EEEEEE"
        android:minHeight="100dp"
        android:text="Здесь будет содержимое файла"
        app:layout_constraintTop_toBottomOf="@id/etFileData" />

    <Button
        android:id="@+id/btnSaveInternal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Сохранить (Внутр)"
        app:layout_constraintEnd_toStartOf="@+id/btnReadInternal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFileContent" />

    <Button
        android:id="@+id/btnReadInternal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Прочитать (Внутр)"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnSaveInternal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSaveInternal" />

    <Button
        android:id="@+id/btnSaveExternal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Сохранить (Внеш)"
        app:layout_constraintEnd_toStartOf="@+id/btnReadExternal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSaveInternal" />

    <Button
        android:id="@+id/btnReadExternal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Прочитать (Внеш)"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnSaveExternal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSaveExternal" />

    <Button
        android:id="@+id/btnBackFromFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Назад"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>